import asyncio
import logging
import os
from aiogram import Bot, Dispatcher, F, Router
from aiogram.filters import CommandStart
from aiogram.fsm.context import FSMContext
from aiogram.fsm.state import State, StatesGroup
from aiogram.types import CallbackQuery, InlineKeyboardButton, InlineKeyboardMarkup, Message
from dotenv import load_dotenv

load_dotenv()

TOKEN = os.getenv("BOT_TOKEN")
ADMIN_ID = os.getenv("ADMIN_ID")

logging.basicConfig(level=logging.INFO)

class OrderForm(StatesGroup):
    country = State()
    city = State()
    address = State()
    photos = State()
    task = State()
    urgency = State()

router = Router()

@router.message(CommandStart())
async def cmd_start(message: Message, state: FSMContext):
    await state.clear()
    keyboard = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🚀 Сделать заказ", callback_data="start_order")]
    ])
    await message.answer(
        "Добро пожаловать в сервис **СПОРТ УСЛУГИ**!\n\n"
        "Для оформления заказа заполните небольшую анкету.",
        reply_markup=keyboard
    )

@router.callback_query(F.data == "start_order")
async def process_start_order(callback: CallbackQuery, state: FSMContext):
    keyboard = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🇺🇦 Украина", callback_data="country_Ukraine")],
        [InlineKeyboardButton(text="🇷🇺 Россия", callback_data="country_Russia")],
        [InlineKeyboardButton(text="🇧🇾 Беларусь", callback_data="country_Belarus")],
        [InlineKeyboardButton(text="🇰🇿 Казахстан", callback_data="country_Kazakhstan")]
    ])
    await callback.message.edit_text("**Шаг 1 из 6:** Выберите страну:", reply_markup=keyboard)
    await state.set_state(OrderForm.country)
    await callback.answer()

@router.callback_query(OrderForm.country, F.data.startswith("country_"))
async def process_country(callback: CallbackQuery, state: FSMContext):
    country = callback.data.split("_")[1]
    country_map = {"Ukraine": "Украина", "Russia": "Россия", "Belarus": "Беларусь", "Kazakhstan": "Казахстан"}
    selected_country = country_map.get(country, country)
    await state.update_data(country=selected_country)
    
    await callback.message.edit_text(f"Страна: **{selected_country}**\n\n**Шаг 2 из 6:** Введите название города (текстом):")
    await state.set_state(OrderForm.city)
    await callback.answer()

@router.message(OrderForm.city)
async def process_city(message: Message, state: FSMContext):
    await state.update_data(city=message.text)
    await message.answer(f"Город: **{message.text}**\n\n**Шаг 3 из 6:** Введите адрес цели (текстом):")
    await state.set_state(OrderForm.address)

@router.message(OrderForm.address)
async def process_address(message: Message, state: FSMContext):
    await state.update_data(address=message.text)
    await state.update_data(photos=[])
    
    keyboard = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="✅ Готово / Продолжить", callback_data="finish_photos")]
    ])
    await message.answer(
        "Адрес принят.\n\n"
        "**Шаг 4 из 6:** Прикрепите фото цели (**от 1 до 3 фото**).\n"
        "Отправляйте фотографии по одной. Когда закончите, нажмите кнопку ниже:",
        reply_markup=keyboard
    )
    await state.set_state(OrderForm.photos)

@router.message(OrderForm.photos, F.photo)
async def process_photos(message: Message, state: FSMContext):
    data = await state.get_data()
    photos = data.get("photos", [])
    
    if len(photos) >= 3:
        await message.answer("Вы уже загрузили максимальное количество фото (3). Нажмите кнопку «Готово / Продолжить».")
        return
        
    photo_id = message.photo[-1].file_id
    photos.append(photo_id)
    await state.update_data(photos=photos)
    
    keyboard = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text=f"✅ Готово (загружено {len(photos)}/3)", callback_data="finish_photos")]
    ])
    
    if len(photos) >= 3:
        await message.answer(f"Загружено фото: {len(photos)}/3 (максимум). Нажмите кнопку для продолжения:", reply_markup=keyboard)
    else:
        await message.answer(f"Фото #{len(photos)} добавлено. Можете отправить следующее или нажать кнопку:", reply_markup=keyboard)

@router.callback_query(OrderForm.photos, F.data == "finish_photos")
async def finish_photos(callback: CallbackQuery, state: FSMContext):
    data = await state.get_data()
    photos = data.get("photos", [])
    if not photos:
        await callback.answer("Загрузите хотя бы 1 фотографию цели!", show_alert=True)
        return
        
    await callback.message.answer("**Шаг 5 из 6:** Опишите, что нужно сделать (введите текстом):")
    await state.set_state(OrderForm.task)
    await callback.answer()

@router.message(OrderForm.task)
async def process_task(message: Message, state: FSMContext):
    await state.update_data(task=message.text)
    
    keyboard = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="⚡ Сейчас", callback_data="urgency_Сейчас")],
        [InlineKeyboardButton(text="📅 Сегодня", callback_data="urgency_Сегодня")],
        [InlineKeyboardButton(text="⏳ В течение 2-3 дней", callback_data="urgency_2-3_days")]
    ])
    await message.answer("**Шаг 6 из 6:** Выберите срочность выполнения:", reply_markup=keyboard)
    await state.set_state(OrderForm.urgency)

@router.callback_query(OrderForm.urgency, F.data.startswith("urgency_"))
async def process_urgency(callback: CallbackQuery, state: FSMContext):
    urgency_raw = callback.data.split("_")[1]
    urgency_map = {"Сейчас": "Сейчас", "Сегодня": "Сегодня", "2-3": "В течение 2-3 дней"}
    urgency = urgency_map.get(urgency_raw, urgency_raw)
    await state.update_data(urgency=urgency)
    
    data = await state.get_data()
    
    summary = (
        f"📋 **Ваша заявка принята!**\n\n"
        f"🌍 **Страна:** {data.get('country')}\n"
        f"🏙 **Город:** {data.get('city')}\n"
        f"📍 **Адрес:** {data.get('address')}\n"
        f"📝 **Задача:** {data.get('task')}\n"
        f"⏱ **Срочность:** {data.get('urgency')}\n"
    )
    await callback.message.answer(summary, parse_mode="Markdown")
    
    payment_text = (
        f"💳 **Блок оплаты заказа**\n\n"
        f"Для подтверждения заявки необходимо произвести оплату:\n"
        f"• **Сумма:** 600$\n"
        f"• **Сеть:** USDT (TRC20)\n"
        f"• **Реквизиты:** `TCRbjQUidQfszDWEMnyWQVUscRj7CoqRTn`\n\n"
        f"⚠️ *Оплата проверяется вручную. После перевода заявка уходит в работу.*"
    )
    await callback.message.answer(payment_text, parse_mode="Markdown")
    
    if ADMIN_ID:
        try:
            admin_id = int(ADMIN_ID)
            admin_msg = f"🚨 **НОВЫЙ ЗАКАЗ СПОРТ УСЛУГИ**\n\n{summary}"
            await callback.bot.send_message(admin_id, admin_msg, parse_mode="Markdown")
            for p in data.get("photos", []):
                await callback.bot.send_photo(admin_id, p)
        except Exception as e:
            logging.error(f"Error sending to admin: {e}")
            
    await state.clear()
    await callback.answer()

async def main():
    if not TOKEN:
        print("Ошибка: BOT_TOKEN не задан!")
        return
    bot = Bot(token=TOKEN)
    dp = Dispatcher()
    dp.include_router(router)
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
